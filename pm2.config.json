{
    "apps": [
        {
            "name": "gold-monitor",
            "script": "python3 main.py",
            "error_file": "./logs/error.log",
            "out_file": "./logs/out.log",
            "merge_logs": true,
            "log_date_format": "YYYY-MM-DD HH:mm:ss",
            "autorestart": true,
            "watch": [
                "main.py"
            ]
        }
    ]
}